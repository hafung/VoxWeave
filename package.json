{
  "name": "voxweave",
  "version": "0.2.1",
  "private": true,
  "description": "声织 VoxWeave — local-first voice creation studio powered by Qwen3-TTS",
  "author": "VoxWeave Contributors",
  "main": "dist-electron/electron/main.js",
  "bin": {"voxweave": "dist-electron/cli/voxweave.js"},
  "type": "module",
  "scripts": {
    "dev": "pnpm build:preload && concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 file:dist-electron/electron/main.js file:dist-electron/electron/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/electron/preload.cjs",
    "build": "tsc -p tsconfig.electron.json && pnpm build:preload && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run --exclude \"dist-electron/**\"",
    "start": "electron .",
    "cli": "tsx cli/voxweave.ts",
    "package:win": "pnpm build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.2.8",
    "commander": "^14.0.0",
    "electron-store": "^11.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "studio.voxweave.app",
    "productName": "声织 VoxWeave",
    "asar": true,
    "files": ["dist/**/*", "dist-electron/**/*", "package.json", "LICENSES.md"],
    "extraResources": [{"from": "resources", "to": ".", "filter": ["**/*"]}],
    "directories": {"output": "release"},
    "win": {"target": ["nsis", "portable"]},
    "nsis": {"artifactName": "VoxWeave-Setup-${version}-${arch}.${ext}", "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true},
    "portable": {"artifactName": "VoxWeave-Portable-${version}-${arch}.${ext}"}
  }
}
